{
  "push": [
    {
      "name": "source",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run check --profile first-party",
        "node --test tests/hosted-mail.test.mjs"
      ]
    },
    {
      "name": "typecheck",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run typecheck",
        "pnpm run test:typecheck"
      ]
    },
    {
      "name": "runtime",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run build",
        "node --test tests/demo-owner-claim.test.mjs",
        "pnpm run test:runtime",
        "node tests/bifocal-certified-metrics.mjs",
        "node tests/bifocal-questions.mjs",
        "pnpm run test:site"
      ]
    },
    {
      "name": "models",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "node scripts/prepare-model-tools.mjs",
        "node tests/bifocal-semantic-model.mjs"
      ]
    }
  ],
  "nightly": []
}
