{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "just-every-bifocal",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foundation",
      "database_id": "local-foundation-only",
      "migrations_dir": "migrations/core"
    }
  ],
  "vars": {
    "AUTH_ORIGIN": "",
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "",
    "MAIL_FROM": "",
    "MAIL_RELAY_URL": "",
    "MAIL_ACCOUNT_ID": "",
    "IDENTITY_PROVIDER": "",
    "OWNER_EMAIL": ""
  }
}
